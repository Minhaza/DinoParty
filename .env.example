# Copy to .env (gitignored) and adjust. Placeholders only - never commit real secrets.

# --- PostgreSQL container (deploy/compose.dev.yml) ---
POSTGRES_DB=dinoparty
POSTGRES_USER=dinoparty
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5433

# --- Backend (read by the `dev` profile from ../.env, or set as real env vars) ---
DB_URL=jdbc:postgresql://localhost:5433/dinoparty
DB_USER=dinoparty
DB_PASSWORD=change-me
# Comma-separated origin allowlist (no wildcards)
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Frontend origin used in room invite links
APP_PUBLIC_URL=http://localhost:5173
# Guest session lifetime (sliding), e.g. 30d
TOKEN_TTL=30d

# --- Optional observability (docs/observability.md) ---
# Export traces, metrics and logs over OTLP/HTTP. Leave false to disable all telemetry.
OTEL_ENABLED=false
# Base URL of the OTLP/HTTP receiver (the OpenTelemetry Collector from deploy/compose.observability.yml)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# 1.0 = trace every request (fine locally); lower it elsewhere
OTEL_TRACES_SAMPLING_PROBABILITY=1.0
ASPIRE_UI_PORT=18888
OTEL_COLLECTOR_HTTP_PORT=4318
# Browser origin the Collector accepts telemetry from (exact origin, no wildcard)
OTEL_ALLOWED_ORIGIN=http://localhost:5173
# Browser telemetry is VITE_OTEL_ENABLED=true in the shell or frontend/.env.local (Vite does not read this file)
